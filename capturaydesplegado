;¿Qué hace el código?: Solicita al usuario ingresar una cadena de texto desde la consola utilizando ReadString, la almacena en un búfer en memoria y la despliega nuevamente en pantalla con WriteString.


  INCLUDE Irvine32.inc

.data
    msgPrompt BYTE "Ingrese un mensaje: ", 0
    msgSalida BYTE "Mensaje capturado: ", 0
    buffer    BYTE 100 DUP(0)
    bytesRead DWORD ?

.code
main PROC
    call Clrscr

    mov edx, OFFSET msgPrompt
    call WriteString

    mov edx, OFFSET buffer
    mov ecx, SIZEOF buffer - 1
    call ReadString
    mov bytesRead, eax

    call Crlf
    mov edx, OFFSET msgSalida
    call WriteString

    mov edx, OFFSET buffer
    call WriteString
    call Crlf

    exit
main ENDP
END main
